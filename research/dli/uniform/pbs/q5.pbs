#!/bin/bash
#PBS -N q5
#PBS -l select=1:ncpus=8:mem=96gb:scratch_ssd=100gb:cpu_vendor=amd
#PBS -j oe
#
# Q5 imbalance trigger (research/dli/uniform/Q5_PREREGISTRATION.md). One job per plan: E1, E1R and E1T run
# serially on one node, then the per-arm gates and the analysis.
#
#   qsub -l walltime=24:00:00 -v PLANID=S1|S2|I1,IN=<staged dir>[,EVAL=0,1,...] q5.pbs
#
# The staged dir holds source.bundle, native.commit, vendor.tar, cargo-config.toml and inputs.sha256.
# Inputs per plan live in $U/inputs/<PLANID>/ (plan/ and corpus.f16 or a corpus reference) and are verified here.
set -euo pipefail
: "${PBS_JOBID:?must run under PBS}" "${SCRATCHDIR:?scratch_ssd required}" "${PLANID:?}" "${IN:?}"
ROOT=/storage/budejovice1/home/nico/lmi-metacentrum
U="$ROOT/uniform-20261127"
BINCACHE="$ROOT/dli-emma-path-20261120/bin-cache"
CORPUS10M="$ROOT/results/sisap23-matched-final-20261028-01/corpus.f16le"
PREFIX_BYTES=1536000000
EXPECTED_COMMIT=$(cat "$IN/native.commit")
case "$PLANID" in
  S1) SCENARIO=shift;       SEED=20261121; SETS=mq,mq_val; PRIMARY=mq
      CORPUS_SRC="$CORPUS10M"; CORPUS_SHA=6e1c72378fee6a1018b7c131d9f171e51dd6e167d81e25d62116fb5a229b1df2 ;;
  S2) SCENARIO=shift;       SEED=20261127; SETS=mq,mq_val; PRIMARY=mq
      CORPUS_SRC="$U/inputs/S2/corpus.f16le"; CORPUS_SHA=$(cat "$U/inputs/S2/corpus.sha256") ;;
  I1) SCENARIO=insert_only; SEED=20261121; SETS=test,val; PRIMARY=test
      CORPUS_SRC="$CORPUS10M"; CORPUS_SHA=6e1c72378fee6a1018b7c131d9f171e51dd6e167d81e25d62116fb5a229b1df2 ;;
  *) echo "unknown PLANID $PLANID"; exit 2 ;;
esac
LABEL="q5-$PLANID${EVAL:+-eval$(echo "$EVAL" | tr , _)}"
OUT="$U/results/$LABEL-$PBS_JOBID"
mkdir -p "$U/results"; mkdir "$OUT"                  # never reuse a result directory
exec > >(tee "$OUT/job.log") 2>&1
W="$SCRATCHDIR/work"
phase=start
finish() {
  rc=$?
  if [[ $rc -ne 0 ]]; then
    printf '{"job":"%s","label":"%s","phase":"%s","exit":%d,"utc":"%s"}\n' \
      "$PBS_JOBID" "$LABEL" "$phase" "$rc" "$(date -u +%FT%TZ)" > "$OUT/FAILED.json"
    for f in "$W"/run/*/out/*.jsonl "$W"/run/*/run.log; do
      [[ -f "$f" ]] && cp -n "$f" "$OUT/partial-$(basename "$(dirname "$(dirname "$f")")")-$(basename "$f")" || true
    done
  fi
  rm -rf "$W"
  exit $rc
}
trap finish EXIT
echo "START $(date -u +%FT%TZ) host=$(hostname) job=$PBS_JOBID label=$LABEL commit=$EXPECTED_COMMIT"
{ lscpu; free -g; df -h "$SCRATCHDIR"; } > "$OUT/hardware.txt"

phase=verify_inputs
( cd "$IN" && sha256sum -c inputs.sha256 )
phase=environment
source "$ROOT/development-search-timeout-24900597-20261026/sisap23-build-environment-v1.sh"
sisap23_export_build_environment
sisap23_load_build_modules
sisap23_check_build_environment | tee "$OUT/toolchain.txt"
PY="$SISAP23_PYTHON_ENV/bin/python"

phase=stage
git() { command git -c filter.lfs.smudge= -c filter.lfs.clean= -c filter.lfs.process= -c filter.lfs.required=false "$@"; }
export GIT_LFS_SKIP_SMUDGE=1
mkdir -p "$W/data" "$W/run"
git clone --quiet --no-checkout "$IN/source.bundle" "$W/qdrant"
git -C "$W/qdrant" checkout --quiet --detach "$EXPECTED_COMMIT"
test "$(git -C "$W/qdrant" rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git -C "$W/qdrant" status --porcelain)"
HERE="$W/qdrant/research/dli/uniform"
"$PY" -I "$HERE/test_analyze_q5.py" > "$OUT/python-tests.log"
tar -C "$W" -xf "$IN/vendor.tar"
mkdir -p "$W/qdrant/.cargo"
sed "s|__VENDOR_DIR__|$W/vendor|" "$IN/cargo-config.toml" > "$W/qdrant/.cargo/config.toml"
head -c "$PREFIX_BYTES" "$CORPUS_SRC" > "$W/data/vectors.f16"
echo "$CORPUS_SHA  $W/data/vectors.f16" | sha256sum -c -
cp -r "$U/inputs/$PLANID/plan" "$W/plan"; chmod -R u+w "$W/plan"
"$PY" -I -c "
import json,sys,hashlib,pathlib
d=pathlib.Path(sys.argv[1]); m=json.load(open(d/'plan.json'))
bad=[f for f,h in m['files'].items() if hashlib.sha256((d/f).read_bytes()).hexdigest()!=h]
assert not bad, bad; assert m['seed']==int(sys.argv[2]) and m['scenario']==sys.argv[3], 'plan identity'
print('plan verified:', len(m['files']), 'files, seed', m['seed'], m['scenario'])" "$W/plan" "$SEED" "$SCENARIO" | tee "$OUT/plan-check.txt"
sha256sum "$W/plan/plan.json" | tee "$OUT/plan.json.sha256"

phase=build
cd "$W/qdrant"
SRC_KEY=$(git rev-parse HEAD:lib HEAD:src HEAD:Cargo.toml HEAD:Cargo.lock | sha256sum | cut -c1-24)
CACHE="$BINCACHE/$SRC_KEY"
echo "source key $SRC_KEY" | tee "$OUT/source-key.txt"
if [[ -f "$CACHE/collection.sha256" ]] && ( cd "$CACHE" && sha256sum -c --quiet collection.sha256 ); then
  mkdir -p "$W/target/perf/deps"; cp "$CACHE/collection" "$W/target/perf/deps/collection-cached"
  BIN="$W/target/perf/deps/collection-cached"; cp "$CACHE/provenance.json" "$OUT/binary-cache-provenance.json"
else
  export CARGO_TARGET_DIR="$W/target" CARGO_BUILD_JOBS=$NCPUS
  /usr/bin/time -v cargo test --locked --offline --profile perf -p collection --lib \
      --features 'testing,lmi-training,dli-research' --no-run > "$OUT/build.stdout" 2> "$OUT/build.stderr"
  BIN=$(ls -t "$W/target/perf/deps"/collection-* | grep -v '\.d$' | head -1)
  mkdir -p "$CACHE.tmp-$PBS_JOBID"; cp "$BIN" "$CACHE.tmp-$PBS_JOBID/collection"
  ( cd "$CACHE.tmp-$PBS_JOBID" && sha256sum collection > collection.sha256 )
  printf '{"built_by_job":"%s","commit":"%s","source_key":"%s","host":"%s","utc":"%s"}\n' \
    "$PBS_JOBID" "$EXPECTED_COMMIT" "$SRC_KEY" "$(hostname)" "$(date -u +%FT%TZ)" > "$CACHE.tmp-$PBS_JOBID/provenance.json"
  [[ -e "$CACHE" ]] || mv "$CACHE.tmp-$PBS_JOBID" "$CACHE"
fi
sha256sum "$BIN" | tee "$OUT/binary.sha256"
"$BIN" --exact collection_manager::dli_schedule::tests::imbalance_retrain_matches_the_frozen_postgres_rule \
    collection_manager::dli_schedule::tests::imbalance_retrain_off_keeps_the_serialized_policy \
    tests::lmi_lifecycle::dli_sisap_scaling_benchmark::imbalance_trigger_off_equals_e1_and_on_retrains_eligible_levels \
    tests::lmi_lifecycle::dli_sisap_scaling_benchmark::emma_level_rule_and_router_reuse_in_configured_collection \
    > "$OUT/unit-tests.log" 2>&1
grep -q "test result: ok. 4 passed" "$OUT/unit-tests.log"

BUDGETS=1000,2000,3500,5000,7000,10000,14000,20000,28000,40000,50000,56000,80000,113000,160000,226000,320000,2000000
for ARM in E1 E1R E1T; do
  phase=run-$ARM
  R="$W/run/$ARM"; mkdir -p "$R/scratch" "$R/out"
  env DLI_ARM=$ARM DLI_P3_VARIANT=none DLI_P3_SYSTEM=dli DLI_P3_PLAN="$W/plan" DLI_P3_CORPUS="$W/data/vectors.f16" \
      DLI_P3_OUTPUT="$R/out" DLI_P3_SCRATCH="$R/scratch" DLI_P3_SETS=$SETS DLI_P3_STATIC_BATCHES= \
      ${EVAL:+DLI_P3_EVAL=$EVAL} DLI_FRONTIER_BUDGETS=$BUDGETS DLI_FRONTIER_POLICIES=mdn_code \
      DLI_BENCH_HEAD="$EXPECTED_COMMIT" QDRANT_DLI_BUILD_CPUS="$NCPUS" DLI_BENCH_PUBLICATION_TIMEOUT_S=14400 \
      QDRANT_LMI_SAMPLE_BUDGET_BYTES=2000000000 \
      QDRANT_OPTIMIZATION_EVENTS="$R/out/native-events.jsonl" QDRANT_LMI_BUILD_EVENTS="$R/out/build-events.jsonl" \
      /usr/bin/time -v "$BIN" --ignored --exact tests::lmi_lifecycle::dli_sisap_scaling_benchmark::dli_phase3_workload \
      --nocapture > "$R/run.log" 2>&1
  mkdir -p "$OUT/$ARM"; cp -r "$R/out/." "$OUT/$ARM/"; cp "$R/run.log" "$OUT/$ARM/"
  rm -rf "$R"
  echo "ARM_DONE $ARM $(date -u +%FT%TZ)"
done

phase=gates
GATES_OK=1
for ARM in E1 E1R E1T; do
  "$PY" -I "$HERE/q5_gates.py" --run "$OUT/$ARM" --plan "$W/plan" --sets $SETS --arm $ARM --e1 "$OUT/E1" \
      --out "$OUT/gates-$ARM.json" || GATES_OK=0
done
phase=analysis
for S in ${SETS//,/ }; do
  "$PY" -I "$HERE/analyze_q5.py" --run E1="$OUT/E1" --run E1R="$OUT/E1R" --run E1T="$OUT/E1T" --set $S \
      --out "$OUT/analysis-$S.json" > "$OUT/analysis-$S.txt"
done
phase=persist
( cd "$OUT" && find . -type f ! -name SHA256SUMS ! -name job.log -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS )
( cd "$OUT" && sha256sum -c --quiet SHA256SUMS )
[[ $GATES_OK = 1 ]] || { phase=gates_failed; echo "a gate failed; data kept"; exit 1; }
printf '{"job":"%s","label":"%s","commit":"%s","primary_set":"%s","utc":"%s","status":"COMPLETED (not ACCEPTED until reviewed)"}\n' \
  "$PBS_JOBID" "$LABEL" "$EXPECTED_COMMIT" "$PRIMARY" "$(date -u +%FT%TZ)" > "$OUT/COMPLETE.json"
phase=done
echo "COMPLETE $(date -u +%FT%TZ)"
