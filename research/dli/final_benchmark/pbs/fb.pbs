#!/bin/bash
#PBS -N fb
#PBS -l select=1:ncpus=8:mem=96gb:scratch_ssd=100gb:cpu_vendor=amd
#PBS -j oe
#
# Final benchmark (research/dli/final_benchmark/PREREGISTRATION.md). One job per plan, or per
# (workload, seed, arm, configuration).
#
#   plan:  qsub -l walltime=06:00:00 -v MODE=plan,WORKLOAD=W1,SEED=20261202,IN=<staged dir> fb.pbs
#   arm:   qsub -l walltime=HH:MM:SS -W depend=afterok:<plan job> \
#               -v MODE=pilot|primary,WORKLOAD=W1,SEED=20261202,ARM=S-LMI,CFG=1000,IN=<staged dir> fb.pbs
#
# WORKLOAD: W1 insert_only, W2 constant_r, W3 shift, W4 heavy_r and W5 medium_r (A6). SEED: 20261202 selection pilot, 20261201 primary,
# 20261205 replication. ARM: E1 | DLI-best | S-LMI | IVF | HNSW. CFG: bucket count (S-LMI, IVF) or m (HNSW),
# unused for E1 and DLI-best. pilot reads validation panels only; primary reads test panels only.
set -euo pipefail
: "${PBS_JOBID:?must run under PBS}" "${SCRATCHDIR:?scratch_ssd required}" "${MODE:?}" "${IN:?}" "${WORKLOAD:?}" "${SEED:?}"
ROOT=/storage/budejovice1/home/nico/lmi-metacentrum
FB="$ROOT/final-benchmark-20261126"
BINCACHE="$ROOT/dli-emma-path-20261120/bin-cache"
CORPUS="$ROOT/results/sisap23-matched-final-20261028-01/corpus.f16le"
CORPUS_SHA=f5868d6e002a6e73aea47491ee040a70a151406fe9e4552292428e2bfe0616e5
PREFIX_BYTES=1536000000   # the first 1M rows: every inserted row of a 1M plan
PREFIX_SHA=6e1c72378fee6a1018b7c131d9f171e51dd6e167d81e25d62116fb5a229b1df2
EXPECTED_COMMIT=$(cat "$IN/native.commit")
N=1000000; BATCHES=20
case "$WORKLOAD" in
  W1) SCENARIO=insert_only; VAL=val;                     TEST=test ;;
  W2) SCENARIO=constant_r;  VAL=val;                     TEST=test ;;
  W3) SCENARIO=shift;       VAL=mq_val,ids_val,ood_val;  TEST=mq,ids,ood ;;
  # Amendment A6, the delete-rate sweep: 10% and 50% deletes per batch (W1 = 0%, W2 = 100%).
  W4) SCENARIO=heavy_r;     VAL=val;                     TEST=test ;;
  W5) SCENARIO=medium_r;    VAL=val;                     TEST=test ;;
  *) echo "unknown WORKLOAD $WORKLOAD"; exit 2 ;;
esac
case "$SEED" in 20261201|20261202|20261205) ;; *) echo "SEED is not a preregistered plan seed"; exit 2 ;; esac
case "$MODE" in
  plan) LABEL="plan-$WORKLOAD-$SEED" ;;
  pilot|primary)
    : "${ARM:?}"
    [[ "$MODE" = pilot && "$SEED" != 20261202 ]] && { echo "the pilot uses plan seed 20261202"; exit 2; }
    [[ "$MODE" = primary && "$SEED" = 20261202 ]] && { echo "the primary never uses the selection seed"; exit 2; }
    SETS=$([[ "$MODE" = pilot ]] && echo "$VAL" || echo "$TEST")
    LABEL="$MODE-$WORKLOAD-$SEED-$ARM${CFG:+-$CFG}" ;;
  *) echo "unknown MODE $MODE"; exit 2 ;;
esac
PLANDIR="$FB/plans/$WORKLOAD-$SEED"
OUT="$FB/results/fb-$LABEL-$PBS_JOBID"
mkdir -p "$FB/results"; mkdir "$OUT"                 # never reuse a result directory
exec > >(tee "$OUT/job.log") 2>&1
W="$SCRATCHDIR/work"
phase=start
finish() {
  rc=$?
  if [[ $rc -ne 0 ]]; then
    printf '{"job":"%s","mode":"%s","label":"%s","phase":"%s","exit":%d,"utc":"%s"}\n' \
      "$PBS_JOBID" "$MODE" "$LABEL" "$phase" "$rc" "$(date -u +%FT%TZ)" > "$OUT/FAILED.json"
    for f in "$W"/run/*.log "$W"/run/*.jsonl; do [[ -f "$f" ]] && cp -n "$f" "$OUT/partial-$(basename "$f")" || true; done
  fi
  rm -rf "$W"
  exit $rc
}
trap finish EXIT
echo "START $(date -u +%FT%TZ) host=$(hostname) job=$PBS_JOBID label=$LABEL commit=$EXPECTED_COMMIT"
{ lscpu; free -g; df -h "$SCRATCHDIR"; } > "$OUT/hardware.txt"
# The planner models Qdrant's AVX+FMA Cosine path (fb_plan.qdrant_cosine_preprocess); the oracle gate
# would fail on another path, so refuse such a node up front.
grep -qw avx /proc/cpuinfo && grep -qw fma /proc/cpuinfo || { echo "node lacks AVX/FMA"; exit 3; }

phase=verify_inputs
( cd "$IN" && sha256sum -c inputs.sha256 )
phase=environment
source "$ROOT/development-search-timeout-24900597-20261026/sisap23-build-environment-v1.sh"
sisap23_export_build_environment
sisap23_load_build_modules
sisap23_check_build_environment | tee "$OUT/toolchain.txt"
PY="$SISAP23_PYTHON_ENV/bin/python"
"$PY" -c "import numpy; print('numpy', numpy.__version__)" | tee -a "$OUT/toolchain.txt"

phase=stage
git() { command git -c filter.lfs.smudge= -c filter.lfs.clean= -c filter.lfs.process= -c filter.lfs.required=false "$@"; }
export GIT_LFS_SKIP_SMUDGE=1
mkdir -p "$W/data" "$W/run/scratch"
git clone --quiet --no-checkout "$IN/source.bundle" "$W/qdrant"
git -C "$W/qdrant" checkout --quiet --detach "$EXPECTED_COMMIT"
test "$(git -C "$W/qdrant" rev-parse HEAD)" = "$EXPECTED_COMMIT"
test -z "$(git -C "$W/qdrant" status --porcelain)"
HERE="$W/qdrant/research/dli/final_benchmark"
"$PY" -I "$HERE/test_fb_plan.py" > "$OUT/python-tests.log"
"$PY" -I "$HERE/test_oracle_check.py" >> "$OUT/python-tests.log"
"$PY" -I "$HERE/test_analyze_final.py" >> "$OUT/python-tests.log"

if [[ "$MODE" = plan ]]; then
  # ---------------- plan job: the immutable plan shared by every arm of (WORKLOAD, SEED) ----------------
  phase=plan_stage
  [[ -e "$PLANDIR" ]] && { echo "plan $PLANDIR already exists; plans are immutable"; exit 4; }
  /usr/bin/time -v cp "$CORPUS" "$W/data/corpus.f16" 2> "$OUT/stage-corpus.time"
  echo "$CORPUS_SHA  $W/data/corpus.f16" | sha256sum -c -
  phase=plan
  /usr/bin/time -v "$PY" -I "$HERE/fb_plan.py" --corpus "$W/data/corpus.f16" --rows "$N" --scenario "$SCENARIO" \
      --batches "$BATCHES" --seed "$SEED" --out "$W/plan" > "$OUT/plan.log" 2>&1
  phase=plan_publish
  mkdir -p "$FB/plans"
  cp -r "$W/plan" "$PLANDIR.tmp-$PBS_JOBID"
  "$PY" -I -c "
import json,sys,hashlib,pathlib
d=pathlib.Path(sys.argv[1]); m=json.load(open(d/'plan.json'))['files']
bad=[f for f,h in m.items() if hashlib.sha256((d/f).read_bytes()).hexdigest()!=h]
assert not bad, bad; print('plan copy verified:', len(m), 'files')" "$PLANDIR.tmp-$PBS_JOBID" | tee "$OUT/plan-check.txt"
  mv "$PLANDIR.tmp-$PBS_JOBID" "$PLANDIR"
  chmod -R a-w "$PLANDIR"
  sha256sum "$PLANDIR/plan.json" | tee "$OUT/plan.json.sha256"
  cp "$PLANDIR/plan.json" "$OUT/"
else
  # ---------------- arm job ----------------
  phase=stage_arm
  tar -C "$W" -xf "$IN/vendor.tar"
  mkdir -p "$W/qdrant/.cargo"
  sed "s|__VENDOR_DIR__|$W/vendor|" "$IN/cargo-config.toml" > "$W/qdrant/.cargo/config.toml"
  head -c "$PREFIX_BYTES" "$CORPUS" > "$W/data/vectors.f16"
  echo "$PREFIX_SHA  $W/data/vectors.f16" | sha256sum -c -
  cp -r "$PLANDIR" "$W/plan"; chmod -R u+w "$W/plan"
  "$PY" -I -c "
import json,sys,hashlib,pathlib
d=pathlib.Path(sys.argv[1]); m=json.load(open(d/'plan.json'))
bad=[f for f,h in m['files'].items() if hashlib.sha256((d/f).read_bytes()).hexdigest()!=h]
assert not bad, bad; assert m['seed']==int(sys.argv[2]) and m['scenario']==sys.argv[3], 'plan identity'
print('plan verified:', len(m['files']), 'files, seed', m['seed'], m['scenario'])" "$W/plan" "$SEED" "$SCENARIO" | tee "$OUT/plan-check.txt"
  sha256sum "$W/plan/plan.json" | tee "$OUT/plan.json.sha256"

  phase=build
  cd "$W/qdrant"
  SRC_KEY=$(git rev-parse HEAD:lib HEAD:src HEAD:Cargo.toml HEAD:Cargo.lock | sha256sum | cut -c1-24)
  CACHE="$BINCACHE/$SRC_KEY"
  echo "source key $SRC_KEY" | tee "$OUT/source-key.txt"
  if [[ -f "$CACHE/collection.sha256" ]] && ( cd "$CACHE" && sha256sum -c --quiet collection.sha256 ); then
    mkdir -p "$W/target/perf/deps"
    cp "$CACHE/collection" "$W/target/perf/deps/collection-cached"
    BIN="$W/target/perf/deps/collection-cached"
    cp "$CACHE/provenance.json" "$OUT/binary-cache-provenance.json"
    echo "binary from cache $CACHE" | tee -a "$OUT/source-key.txt"
  else
    export CARGO_TARGET_DIR="$W/target" CARGO_BUILD_JOBS=$NCPUS
    /usr/bin/time -v cargo test --locked --offline --profile perf -p collection --lib \
        --features 'testing,lmi-training,dli-research' --no-run > "$OUT/build.stdout" 2> "$OUT/build.stderr"
    BIN=$(ls -t "$W/target/perf/deps"/collection-* | grep -v '\.d$' | head -1)
    mkdir -p "$CACHE.tmp-$PBS_JOBID"
    cp "$BIN" "$CACHE.tmp-$PBS_JOBID/collection"
    ( cd "$CACHE.tmp-$PBS_JOBID" && sha256sum collection > collection.sha256 )
    printf '{"built_by_job":"%s","commit":"%s","source_key":"%s","host":"%s","utc":"%s"}\n' \
      "$PBS_JOBID" "$EXPECTED_COMMIT" "$SRC_KEY" "$(hostname)" "$(date -u +%FT%TZ)" > "$CACHE.tmp-$PBS_JOBID/provenance.json"
    cp "$OUT/toolchain.txt" "$CACHE.tmp-$PBS_JOBID/"
    [[ -e "$CACHE" ]] || mv "$CACHE.tmp-$PBS_JOBID" "$CACHE"
    rm -rf "$CACHE.tmp-$PBS_JOBID"
  fi
  sha256sum "$BIN" | tee "$OUT/binary.sha256"
  phase=unit_tests
  "$BIN" --exact tests::lmi_lifecycle::dli_selection_frontier::g1_recall_counts_tied_copies_and_caps_at_top \
      tests::lmi_lifecycle::dli_selection_frontier::ivf_router_classifier_and_centroid_ranking \
      tests::lmi_lifecycle::dli_selection_frontier::ivf_centroid_ranking_rejects_a_wrong_pick \
      collection_manager::dli_bucket_plan::tests::proportional_splits_by_live_population_and_always_scores_buffer \
      tests::lmi_lifecycle::dli_sisap_scaling_benchmark::dli_best_maintenance_and_proportional_serving_in_configured_collection \
      > "$OUT/unit-tests.log" 2>&1
  grep -q "test result: ok. 5 passed" "$OUT/unit-tests.log"

  phase=configure
  DLI_BUDGETS=1000,2000,3500,5000,7000,10000,14000,20000,28000,40000,50000,56000,80000,113000,160000,226000,320000,2000000
  HNSW_EFS=30,45,64,90,128,181,256,362,512,724,1024,1448,2048
  nprobes() { local b=$1 p=1 out=""; while (( p < b )); do out+="$p,"; p=$((p*2)); done; echo "${out}$b"; }
  ENVS=(DLI_ARM=E1 DLI_P3_PLAN="$W/plan" DLI_P3_CORPUS="$W/data/vectors.f16" DLI_P3_OUTPUT="$OUT/run"
        DLI_P3_SCRATCH="$W/run/scratch" DLI_P3_SETS="$SETS" DLI_P3_STATIC_BATCHES= DLI_P3_TIMED=1
        DLI_BENCH_HEAD="$EXPECTED_COMMIT" DLI_BENCH_PUBLICATION_TIMEOUT_S=14400 QDRANT_DLI_BUILD_CPUS="$NCPUS"
        QDRANT_LMI_SAMPLE_BUDGET_BYTES=2000000000
        QDRANT_OPTIMIZATION_EVENTS="$W/run/native-events.jsonl" QDRANT_LMI_BUILD_EVENTS="$W/run/build-events.jsonl")
  case "$ARM" in
    E1)       ENVS+=(DLI_P3_SYSTEM=dli DLI_P3_VARIANT=none DLI_FRONTIER_BUDGETS=$DLI_BUDGETS
                     DLI_FRONTIER_POLICIES=mdn_code DLI_P3_TIMED_POLICIES=mdn_code) ;;
    DLI-best) ENVS+=(DLI_P3_SYSTEM=dli DLI_P3_VARIANT=dlibest DLI_FRONTIER_BUDGETS=$DLI_BUDGETS
                     DLI_FRONTIER_POLICIES=mdn_code,proportional,proportional_native
                     DLI_P3_TIMED_POLICIES=proportional_native) ;;
    S-LMI|IVF) : "${CFG:?bucket count}"
              case "$CFG" in 250|1000|3162|10000) ;; *) echo "bucket count not in the pilot set (A1.2 adds 10000)"; exit 2 ;; esac
              ENVS+=(DLI_P3_SYSTEM=static DLI_P3_STATIC_BUCKETS="$CFG" DLI_P3_STATIC_SEGMENTS=1
                     DLI_P3_STATIC_INDEXING_KB=20000 DLI_P3_STATIC_NPROBES="$(nprobes "$CFG")")
              [[ "$ARM" = IVF ]] && ENVS+=(LMI_RESEARCH_ROUTER=centroid) || ENVS+=(LMI_RESEARCH_ROUTER=mlp) ;;
    HNSW)     : "${CFG:?m}"
              case "$CFG" in 16|32) ;; *) echo "m not in the pilot set"; exit 2 ;; esac
              ENVS+=(DLI_P3_SYSTEM=hnsw DLI_P3_HNSW_M="$CFG" DLI_P3_HNSW_EF_CONSTRUCT=100 DLI_P3_STATIC_SEGMENTS=1
                     DLI_P3_STATIC_INDEXING_KB=20000 DLI_P3_HNSW_EFS=$HNSW_EFS) ;;
    *) echo "unknown ARM $ARM"; exit 2 ;;
  esac
  printf '%s\n' "${ENVS[@]}" | sed "s|$W|\$W|g" > "$OUT/run-env.txt"

  phase=run
  env "${ENVS[@]}" /usr/bin/time -v "$BIN" --ignored --exact \
      tests::lmi_lifecycle::dli_sisap_scaling_benchmark::dli_phase3_workload --nocapture > "$W/run/run.log" 2>&1
  shopt -s nullglob; cp "$W/run/run.log" "$W/run"/*.jsonl "$OUT/run/"; shopt -u nullglob

  phase=oracle
  "$PY" -I "$HERE/oracle_check.py" --corpus "$W/data/vectors.f16" --run "$OUT/run" --out "$OUT/oracle.json" > /dev/null

  phase=gates
  "$PY" -I -c "
import json,sys; sys.path.insert(0,sys.argv[1]); import analyze_final as A
run={'workload':sys.argv[2],'seed':int(sys.argv[3]),'arm':sys.argv[4],'dir':sys.argv[5],'plan':sys.argv[6]}
g=A.gates(run, sys.argv[7].split(',')); json.dump(g, open(sys.argv[8],'w'), indent=1); print(json.dumps(g))
sys.exit(0 if g['pass'] else 1)" "$HERE" "$WORKLOAD" "$SEED" "$ARM" "$OUT/run" "$W/plan/plan.json" "$SETS" "$OUT/gates.json"
fi

phase=persist
( cd "$OUT" && find . -type f ! -name SHA256SUMS ! -name job.log -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS )
( cd "$OUT" && sha256sum -c --quiet SHA256SUMS )
printf '{"job":"%s","mode":"%s","label":"%s","commit":"%s","utc":"%s","status":"COMPLETED (not ACCEPTED until reviewed)"}\n' \
  "$PBS_JOBID" "$MODE" "$LABEL" "$EXPECTED_COMMIT" "$(date -u +%FT%TZ)" > "$OUT/COMPLETE.json"
phase=done
echo "COMPLETE $(date -u +%FT%TZ)"
