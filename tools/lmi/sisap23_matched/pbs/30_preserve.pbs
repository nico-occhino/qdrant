#!/bin/bash
#PBS -N sisap23-preserve
#PBS -l select=1:ncpus=4:mem=16gb:scratch_local=20gb
#PBS -l walltime=12:00:00
#PBS -j oe
set -euo pipefail
WORKSPACE=${WORKSPACE:-/storage/budejovice1/home/nico/lmi-metacentrum}
QDRANT_DIR=${QDRANT_DIR:-$WORKSPACE/qdrant}
SISAP23_BENCH_ROOT=${SISAP23_BENCH_ROOT:?set the prepared benchmark root}
source "$QDRANT_DIR/tools/lmi/sisap23_matched/pbs/common-env.sh"
verify_benchmark_checkout
test -f "$SISAP23_BENCH_ROOT/suite.complete.json" || { echo "suite did not complete and validate successfully; preservation is blocked" >&2; exit 2; }
python - "$SISAP23_BENCH_ROOT" "$SISAP23_REVIEWED_COMMIT" <<'PY'
import json,sys
from pathlib import Path
root=Path(sys.argv[1])
complete=json.loads((root/"suite.complete.json").read_text())
report=json.loads((root/"validation.json").read_text())
manifest=json.loads((root/"manifest.json").read_text())
assert complete.get("validation") == "passed"
assert report.get("validation") == "passed"
assert complete.get("source_commit") == sys.argv[2] == manifest.get("source_commit")
assert complete.get("manifest_sha256") == report.get("manifest_sha256")
PY
OUT="$SISAP23_BENCH_ROOT/results.sha256"
test ! -e "$OUT" || { echo "preservation inventory already exists; refusing overwrite" >&2; exit 2; }
cd "$SISAP23_BENCH_ROOT"
find manifest.json hardware.txt suite.state suite.complete.json provenance runs validation.json validation.log -type f -print0 | sort -z | xargs -0 sha256sum > "$OUT"
printf 'SISAP23 matched benchmark results preserved at %s\n' "$SISAP23_BENCH_ROOT"
