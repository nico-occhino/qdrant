#!/bin/bash
#PBS -N sisap23-preflight
#PBS -l select=1:ncpus=4:mem=32gb:scratch_local=80gb
#PBS -l walltime=12:00:00
#PBS -j oe
set -euo pipefail
WORKSPACE=${WORKSPACE:-/storage/budejovice1/home/nico/lmi-metacentrum}
QDRANT_DIR=${QDRANT_DIR:-$WORKSPACE/qdrant}
SISAP_SOURCE=${SISAP_SOURCE:-/storage/brno12-cerit/home/prochazka/datasets/sisap23}
SISAP23_BENCH_ROOT=${SISAP23_BENCH_ROOT:?set a new, non-existing benchmark root}
ENV_DIR="$WORKSPACE/envs/py312-torch251"
test -x "$ENV_DIR/bin/python" || {
    echo "Missing Python executable: $ENV_DIR/bin/python" >&2
    exit 2
}
export PATH="$ENV_DIR/bin:$PATH"
python -c "import sys; assert sys.version_info[:2] == (3, 12), f'expected Python 3.12, found {sys.version}'"
source "$QDRANT_DIR/tools/lmi/sisap23_matched/pbs/common-env.sh"
export TMPDIR="${SCRATCHDIR:?PBS scratch allocation required}/tmp"
mkdir -p "$TMPDIR"
verify_benchmark_checkout
python "$QDRANT_DIR/tools/lmi/sisap23_matched/preflight.py" --source "$SISAP_SOURCE" --out "$SISAP23_BENCH_ROOT" --source-commit "$SISAP23_REVIEWED_COMMIT"
