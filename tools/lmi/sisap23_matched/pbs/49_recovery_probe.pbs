#!/bin/bash
#PBS -N sisap23-probe
#PBS -l select=1:ncpus=16:mem=32gb:scratch_local=50gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
export SISAP23_STAGE=probe
export WORKSPACE="${WORKSPACE:-/storage/budejovice1/home/nico/lmi-metacentrum}"
export QDRANT_DIR="${QDRANT_DIR:-$WORKSPACE/qdrant-sisap23-publication-repair}"
source "$QDRANT_DIR/tools/lmi/sisap23_matched/pbs/recovery-env.sh"
