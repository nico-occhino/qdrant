#!/bin/bash
#PBS -N sisap23-build
#PBS -l select=1:ncpus=16:mem=128gb:scratch_local=200gb
#PBS -l walltime=72:00:00
#PBS -j oe
set -euo pipefail
export SISAP23_STAGE=build
export WORKSPACE="${WORKSPACE:-/storage/budejovice1/home/nico/lmi-metacentrum}"
export QDRANT_DIR="${QDRANT_DIR:-$WORKSPACE/qdrant-sisap23-index-topology-diagnostics}"
source "$QDRANT_DIR/tools/lmi/sisap23_matched/pbs/recovery-env.sh"
