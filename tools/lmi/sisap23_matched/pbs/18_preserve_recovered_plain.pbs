#!/bin/bash
#PBS -N sisap23-plain-preserve
#PBS -l select=1:ncpus=16:mem=96gb:scratch_local=200gb
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
WORKSPACE=/storage/budejovice1/home/nico/lmi-metacentrum
QDRANT_DIR=${QDRANT_DIR:?set isolated preservation worktree}
test "$QDRANT_DIR" = "$WORKSPACE/qdrant-sisap23-preservation"
SISAP23_BENCH_ROOT=${SISAP23_BENCH_ROOT:?set original run root}
SISAP23_REVIEWED_COMMIT=${SISAP23_REVIEWED_COMMIT:?pin preservation commit}
test "$(git -C "$QDRANT_DIR" branch --show-current)" = thesis/sisap23-matched-preservation
test "$(git -C "$QDRANT_DIR" rev-parse HEAD)" = "$SISAP23_REVIEWED_COMMIT"
test -z "$(git -C "$QDRANT_DIR" status --porcelain)"
ORIGINAL=42a163701a51078ec24983b3a93f96ab7d661489
grep -Fxq "source_commit=$ORIGINAL" "$SISAP23_BENCH_ROOT/suite.state"
manifest_sha=$(sha256sum "$SISAP23_BENCH_ROOT/manifest.json" | cut -d ' ' -f 1)
grep -Fxq "manifest_sha256=$manifest_sha" "$SISAP23_BENCH_ROOT/suite.state"
test ! -e "$SISAP23_BENCH_ROOT/runs/plain/build.complete.json"
SOURCE="$SISAP23_BENCH_ROOT/runs/plain/collection"
test -d "$SOURCE" && test -f "$SOURCE/0/wal/first-index"
test -z "$(find "$SOURCE" -type l -print -quit)"
ATTEMPT=${PBS_JOBID:?PBS job ID required}
name="plain-wal-$ATTEMPT-${SISAP23_REVIEWED_COMMIT:0:12}"
case "$name" in *[!a-zA-Z0-9._-]*) echo "unsafe generation name" >&2; exit 2;; esac
GENROOT="$SISAP23_BENCH_ROOT/recovered-generations"
mkdir -p "$GENROOT/.staging"
STAGING="$GENROOT/.staging/$name"
FINAL="$GENROOT/$name"
test ! -e "$STAGING" && test ! -e "$FINAL"
mkdir "$STAGING"
REPORT_DIR="$SISAP23_BENCH_ROOT/diagnostics/preservation"
mkdir -p "$REPORT_DIR"
PREFIX="$REPORT_DIR/$name"
export SISAP23_WAL_PRE_REPORT="$PREFIX.pre.json"
export SISAP23_WAL_POST_REPORT="$PREFIX.post.json"
export SISAP23_PERSISTENT_REPORT="$PREFIX.persistent.json"
LOG="$PREFIX.log"
STATUS="$PREFIX.exit-status.txt"
SOURCE_BEFORE="$PREFIX.original-before.sha256"
SOURCE_AFTER="$PREFIX.original-after.sha256"
for path in "$SISAP23_WAL_PRE_REPORT" "$SISAP23_WAL_POST_REPORT" "$SISAP23_PERSISTENT_REPORT" "$LOG" "$STATUS" "$SOURCE_BEFORE" "$SOURCE_AFTER"; do
  test ! -e "$path" || { echo "existing diagnostic: $path" >&2; exit 2; }
done
trap 'code=$?; if test -f "$SOURCE_BEFORE"; then
 find "$SOURCE" -type f -print0 | sort -z | xargs -0 sha256sum > "$SOURCE_AFTER" || code=3
 cmp "$SOURCE_BEFORE" "$SOURCE_AFTER" || code=3
fi
printf "%s\n" "$code" > "$STATUS"; exit "$code"' EXIT
find "$SOURCE" -type f -print0 | sort -z | xargs -0 sha256sum > "$SOURCE_BEFORE"
PROTOBUF_MODULE=${PROTOBUF_MODULE:-protobuf}
module load "$PROTOBUF_MODULE"
source "$QDRANT_DIR/tools/lmi/sisap23_matched/pbs/common-env.sh"
setup_benchmark_build_env
corpus_expected=$(python -c 'import json,sys; print(json.load(open(sys.argv[1]))["prepared"]["corpus"]["sha256"])' "$SISAP23_BENCH_ROOT/manifest.json")
test "$(sha256sum "$SISAP23_BENCH_ROOT/corpus.f16le" | cut -d ' ' -f 1)" = "$corpus_expected"
export SISAP23_WAL_MODE=replay SISAP23_WAL_COMMIT="$SISAP23_REVIEWED_COMMIT"
export SISAP23_WAL_INSPECTION_PATH="$SCRATCHDIR/plain-inspection"
export SISAP23_WAL_COLLECTION_PATH="$SCRATCHDIR/plain-replay"
export SISAP23_PERSISTENT_STAGING_COLLECTION="$STAGING/collection"
export SISAP23_PERSISTENT_VERIFY=1 SISAP23_BENCH_ROOT SCRATCHDIR RUST_BACKTRACE=1
test ! -e "$SISAP23_WAL_INSPECTION_PATH" && test ! -e "$SISAP23_WAL_COLLECTION_PATH"
cp -a "$SOURCE" "$SISAP23_WAL_INSPECTION_PATH"
cp -a "$SOURCE" "$SISAP23_WAL_COLLECTION_PATH"
diff -qr "$SOURCE" "$SISAP23_WAL_INSPECTION_PATH" >/dev/null
diff -qr "$SOURCE" "$SISAP23_WAL_COLLECTION_PATH" >/dev/null
cd "$QDRANT_DIR"
/usr/bin/time -v -o "$PREFIX.replay.resources.txt" cargo test -p collection --release --features lmi-training   sisap23_matched_inspect_or_replay_plain_wal --locked -- --ignored --nocapture > "$LOG" 2>&1
python -c 'import json,sys; assert json.load(open(sys.argv[1]))["accepted"] is True' "$SISAP23_WAL_POST_REPORT"
cp -a "$SISAP23_WAL_COLLECTION_PATH" "$SISAP23_PERSISTENT_STAGING_COLLECTION"
PRESERVE="$QDRANT_DIR/tools/lmi/sisap23_matched/preserve_generation.py"
args=(--scratch "$SISAP23_WAL_COLLECTION_PATH" --staging "$STAGING" --final "$FINAL"   --report "$SISAP23_PERSISTENT_REPORT" --wal-report "$SISAP23_WAL_POST_REPORT"   --commit "$SISAP23_REVIEWED_COMMIT" --job-id "$ATTEMPT" --original "$SOURCE")
python "$PRESERVE" inventory "${args[@]}"
python "$PRESERVE" verify "${args[@]}"
/usr/bin/time -v -o "$PREFIX.persistent.resources.txt" cargo test -p collection --release --features lmi-training   sisap23_matched_verify_persistent_plain_staging --locked -- --ignored --nocapture >> "$LOG" 2>&1
find "$SOURCE" -type f -print0 | sort -z | xargs -0 sha256sum > "$SOURCE_AFTER"
cmp "$SOURCE_BEFORE" "$SOURCE_AFTER" || { echo "original changed; refuse publish" >&2; exit 3; }
python "$PRESERVE" finalize "${args[@]}"
test -f "$FINAL/generation.json"
test ! -e "$SISAP23_BENCH_ROOT/runs/plain/build.complete.json"
printf 'accepted persistent Plain generation: %s\n' "$FINAL"
