#!/bin/bash
#PBS -N sisap23-recovered-matched
#PBS -l select=1:ncpus=16:mem=96gb:scratch_local=200gb
#PBS -l walltime=96:00:00
#PBS -j oe
set -euo pipefail
WORKSPACE=/storage/budejovice1/home/nico/lmi-metacentrum
QDRANT_DIR=${QDRANT_DIR:?set isolated preservation worktree}
test "$QDRANT_DIR" = "$WORKSPACE/qdrant-sisap23-preservation"
SISAP23_REVIEWED_COMMIT=${SISAP23_REVIEWED_COMMIT:?pin preservation commit}
test "$(git -C "$QDRANT_DIR" branch --show-current)" = thesis/sisap23-matched-preservation
test "$(git -C "$QDRANT_DIR" rev-parse HEAD)" = "$SISAP23_REVIEWED_COMMIT"
test -z "$(git -C "$QDRANT_DIR" status --porcelain)"
SISAP23_ORIGINAL_ROOT=${SISAP23_ORIGINAL_ROOT:?set original benchmark root}
SISAP23_IMPORTED_GENERATION=${SISAP23_IMPORTED_GENERATION:?set accepted persistent Plain generation}
SISAP23_BENCH_ROOT=${SISAP23_MATCHED_ROOT:?set NEW matched run root}
test "$SISAP23_BENCH_ROOT" != "$SISAP23_ORIGINAL_ROOT"
test -f "$SISAP23_IMPORTED_GENERATION/generation.json"
PROTOBUF_MODULE=${PROTOBUF_MODULE:-protobuf}
module load "$PROTOBUF_MODULE"
source "$QDRANT_DIR/tools/lmi/sisap23_matched/pbs/common-env.sh"
ENV_DIR="$WORKSPACE/envs/py312-torch251"
test -x "$ENV_DIR/bin/python" || { echo "missing Python environment" >&2; exit 2; }
export PATH="$ENV_DIR/bin:$PATH"
python3 "$QDRANT_DIR/tools/lmi/sisap23_matched/bootstrap_recovered_suite.py"   --original "$SISAP23_ORIGINAL_ROOT" --generation "$SISAP23_IMPORTED_GENERATION"   --new-root "$SISAP23_BENCH_ROOT" --commit "$SISAP23_REVIEWED_COMMIT"
setup_benchmark_build_env
export SISAP23_BENCH_ROOT SISAP23_REVIEWED_COMMIT RUST_BACKTRACE=1
manifest_sha=$(sha256sum "$SISAP23_BENCH_ROOT/manifest.json" | cut -d ' ' -f 1)
fingerprint=$(printf '%s|%s|%s' "$(hostname)" "$(lscpu | awk -F: '/Model name/ {gsub(/^ +/,"",$2); print $2; exit}')" "$(stat -f -c %T "$SISAP23_BENCH_ROOT")")
if test -f "$SISAP23_BENCH_ROOT/suite.state"; then
  grep -Fxq "source_commit=$SISAP23_REVIEWED_COMMIT" "$SISAP23_BENCH_ROOT/suite.state"
  grep -Fxq "manifest_sha256=$manifest_sha" "$SISAP23_BENCH_ROOT/suite.state"
  grep -Fxq "hardware_fingerprint=$fingerprint" "$SISAP23_BENCH_ROOT/suite.state" || {
    echo "different host/CPU/filesystem; use a new matched root" >&2; exit 2;
  }
else
  test ! -e "$SISAP23_BENCH_ROOT/runs/lmi"
  test ! -e "$SISAP23_BENCH_ROOT/runs/hnsw-a"
  test ! -e "$SISAP23_BENCH_ROOT/runs/hnsw-b"
  printf 'source_commit=%s\nmanifest_sha256=%s\nhardware_fingerprint=%s\n'     "$SISAP23_REVIEWED_COMMIT" "$manifest_sha" "$fingerprint" > "$SISAP23_BENCH_ROOT/suite.state"
  { hostname; date -Is; lscpu; df -P "$SISAP23_BENCH_ROOT"; } > "$SISAP23_BENCH_ROOT/hardware.txt"
fi
test ! -e "$SISAP23_BENCH_ROOT/suite.complete.json"
export SISAP23_CORPUS_PATH="$TMPDIR/corpus.f16le"
cp "$SISAP23_BENCH_ROOT/corpus.f16le" "$SISAP23_CORPUS_PATH"
export QDRANT_LMI_SAMPLE_BUDGET_BYTES=${QDRANT_LMI_SAMPLE_BUDGET_BYTES:-768000000}
cd "$QDRANT_DIR"
ATTEMPT=${PBS_JOBID:?PBS job ID required}
for variant in plain lmi hnsw-a hnsw-b; do
  export SISAP23_VARIANT="$variant"
  RUN="$SISAP23_BENCH_ROOT/runs/$variant"
  if test "$variant" != plain; then
    if test -f "$RUN/build.complete.json"; then
      python -c 'import json,sys; assert json.load(open(sys.argv[1]))["source_commit"] == sys.argv[2]'         "$RUN/build.complete.json" "$SISAP23_REVIEWED_COMMIT"
    else
      test ! -e "$RUN/collection" || { echo "partial index generation; retain for diagnosis" >&2; exit 2; }
      mkdir "$RUN"
      RUST_LOG=info /usr/bin/time -v -o "$RUN/build.resources.$ATTEMPT.txt"         cargo test -p collection --release --features lmi-training sisap23_matched_build         --locked -- --ignored --nocapture > "$RUN/build.$ATTEMPT.log" 2>&1
      test -f "$RUN/build.complete.json"
    fi
  else
    test -f "$RUN/imported.generation.json"
    test ! -e "$RUN/build.complete.json"
  fi
  RUST_LOG=info /usr/bin/time -v -o "$RUN/evaluate.resources.$ATTEMPT.txt"     cargo test -p collection --release --features lmi-training sisap23_matched_evaluate     --locked -- --ignored --nocapture > "$RUN/evaluate.$ATTEMPT.log" 2>&1
  grep -q "sisap23_native_evaluation_complete variant=$variant" "$RUN/evaluate.$ATTEMPT.log"
done
python "$QDRANT_DIR/tools/lmi/sisap23_matched/bootstrap_recovered_suite.py"   --original "$SISAP23_ORIGINAL_ROOT" --generation "$SISAP23_IMPORTED_GENERATION"   --new-root "$SISAP23_BENCH_ROOT" --commit "$SISAP23_REVIEWED_COMMIT"
python "$QDRANT_DIR/tools/lmi/sisap23_matched/validate.py" --root "$SISAP23_BENCH_ROOT"   >> "$SISAP23_BENCH_ROOT/validation.log"
python - "$SISAP23_BENCH_ROOT" "$SISAP23_REVIEWED_COMMIT" "$manifest_sha" "$fingerprint" <<'PYEND'
import json, os, sys
from pathlib import Path
root=Path(sys.argv[1])
marker={"format":"sisap23-recovered-matched-complete-v1",
        "source_commit":sys.argv[2],"manifest_sha256":sys.argv[3],
        "hardware_fingerprint":sys.argv[4],"validation":"passed",
        "plain_construction_time_comparable":False}
with (root/"suite.complete.json").open("x") as out:
    json.dump(marker,out,indent=2,sort_keys=True);out.write("\n");out.flush();os.fsync(out.fileno())
PYEND
