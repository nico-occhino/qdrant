#!/bin/bash
#PBS -N sisap23-diagnose-plain
#PBS -l select=1:ncpus=16:mem=96gb:scratch_local=200gb
#PBS -l walltime=24:00:00
set -euo pipefail
test "${SISAP23_DIAG_MODE:-}" = 1 || { echo "set SISAP23_DIAG_MODE=1" >&2; exit 2; }
WORKSPACE=${WORKSPACE:-/storage/budejovice1/home/nico/lmi-metacentrum}
QDRANT_DIR=${QDRANT_DIR:-$WORKSPACE/qdrant}
SISAP23_BENCH_ROOT=${SISAP23_BENCH_ROOT:?set interrupted benchmark root}
SISAP23_DIAG_COMMIT=${SISAP23_DIAG_COMMIT:?set reviewed diagnostic commit}
SISAP23_REVIEWED_COMMIT=$SISAP23_DIAG_COMMIT
ORIGINAL=42a163701a51078ec24983b3a93f96ab7d661489
PROTOBUF_MODULE=${PROTOBUF_MODULE:-protobuf}
module load "$PROTOBUF_MODULE"
source "$QDRANT_DIR/tools/lmi/sisap23_matched/pbs/common-env.sh"
test "$(git -C "$QDRANT_DIR" branch --show-current)" = thesis/sisap23-matched-diagnostics
test "$(git -C "$QDRANT_DIR" rev-parse HEAD)" = "$SISAP23_DIAG_COMMIT"
test -z "$(git -C "$QDRANT_DIR" status --porcelain)" || { echo "diagnostic checkout is dirty" >&2; exit 2; }
test -f "$SISAP23_BENCH_ROOT/manifest.json"
test -f "$SISAP23_BENCH_ROOT/suite.state"
grep -Fxq "source_commit=$ORIGINAL" "$SISAP23_BENCH_ROOT/suite.state"
manifest_sha=$(sha256sum "$SISAP23_BENCH_ROOT/manifest.json" | cut -d ' ' -f 1)
grep -Fxq "manifest_sha256=$manifest_sha" "$SISAP23_BENCH_ROOT/suite.state"
SOURCE="$SISAP23_BENCH_ROOT/runs/plain/collection"
test -d "$SOURCE"
test ! -e "$SISAP23_BENCH_ROOT/runs/plain/build.complete.json"
test ! -e "$SISAP23_BENCH_ROOT/suite.complete.json"
test -z "$(find "$SOURCE" -type l -print -quit)" || { echo "symlink in source collection; refuse copy" >&2; exit 2; }
setup_benchmark_build_env
ATTEMPT=${PBS_JOBID:?PBS job ID required}
DIAG_DIR="$SISAP23_BENCH_ROOT/diagnostics"
mkdir -p "$DIAG_DIR"
SISAP23_DIAG_OUTPUT="$DIAG_DIR/plain.$ATTEMPT.json"
LOG="$DIAG_DIR/plain.$ATTEMPT.log"
FILES="$DIAG_DIR/plain.$ATTEMPT.files.tsv"
test ! -e "$SISAP23_DIAG_OUTPUT" && test ! -e "$LOG" && test ! -e "$FILES"
test ! -e "$DIAG_DIR/plain.$ATTEMPT.copy-diff.txt"
test ! -e "$DIAG_DIR/plain.$ATTEMPT.resources.txt"
find "$SOURCE" -type f -printf '%P\t%s\n' > "$FILES"
SISAP23_DIAG_COLLECTION_PATH="${SCRATCHDIR:?PBS scratch required}/plain-collection"
test ! -e "$SISAP23_DIAG_COLLECTION_PATH"
cp -a "$SOURCE" "$SISAP23_DIAG_COLLECTION_PATH"
diff -qr "$SOURCE" "$SISAP23_DIAG_COLLECTION_PATH" > "$DIAG_DIR/plain.$ATTEMPT.copy-diff.txt" || {
  echo "scratch copy differs from source; refusing diagnostic load" >&2
  exit 2
}
export SISAP23_DIAG_MODE SISAP23_DIAG_COMMIT SISAP23_DIAG_COLLECTION_PATH SISAP23_DIAG_OUTPUT
export SISAP23_BENCH_ROOT SCRATCHDIR RUST_BACKTRACE=1
cd "$QDRANT_DIR"
RUST_LOG=info /usr/bin/time -v -o "$DIAG_DIR/plain.$ATTEMPT.resources.txt" \
  cargo test -p collection --release --features lmi-training sisap23_matched_diagnose_plain --locked -- --ignored --nocapture > "$LOG" 2>&1
grep -q sisap23_plain_diagnostic_report "$LOG"
test -f "$SISAP23_DIAG_OUTPUT"
test ! -e "$SISAP23_BENCH_ROOT/runs/plain/build.complete.json"
printf 'Diagnostic report: %s\n' "$SISAP23_DIAG_OUTPUT"
